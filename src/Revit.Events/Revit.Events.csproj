<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>VolocyNazad</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Copyright>Copyright © VolocyNazad</Copyright>
		<Description>Revit external events.</Description>
		<PackageType>Dependency</PackageType>
		<PackageTags>autodesk;revit;api;events;</PackageTags>
		<PackageId>VolocyNazad.Revit.Events</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!--<PackageIcon>images\PackageIcon.png</PackageIcon>-->
		<PackageProjectUrl>https://github.com/VolocyNazad/toolkit.revit.events</PackageProjectUrl>
		<PackageOutputPath>..\..\artifacts\</PackageOutputPath>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/VolocyNazad/toolkit.revit.events</RepositoryUrl>
		<PackageReleaseNotes>https://github.com/VolocyNazad/toolkit.revit.events/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<!--<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
	</PropertyGroup>

	<ItemGroup>
		<!--<None Include="..\..\.nuget\PackageIcon.png" PackagePath="images/" Pack="true" Visible="false"/>-->
		<None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<Platform>x64</Platform>
		<Configurations>
		  Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
		  Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0
		</Configurations>
	</PropertyGroup>

	<!-- MinVer: the patch portion of the version is taken from git tags/commit history, major stays tied to the Revit version -->
	<PropertyGroup>
		<MinVerTagPrefix></MinVerTagPrefix>
		<MinVerMinimumMajorMinor>0.0</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<Target Name="ApplyRevitVersion" AfterTargets="MinVer" BeforeTargets="GetAssemblyVersion;GenerateNuspec;CoreCompile">
		<PropertyGroup>
			<!-- AssemblyVersion/FileVersion — numbers only, System.Version does not support suffixes -->
			<AssemblyVersion>$(MajorRevitVersion).0.$(MinVerPatch)</AssemblyVersion>
			<FileVersion>$(MajorRevitVersion).0.$(MinVerPatch)</FileVersion>

			<!-- Version/PackageVersion — with a "-dev.N" suffix if the build is not from a tagged commit -->
			<Version Condition="'$(MinVerPreRelease)' == ''">$(MajorRevitVersion).0.$(MinVerPatch)</Version>
			<Version Condition="'$(MinVerPreRelease)' != ''">$(MajorRevitVersion).0.$(MinVerPatch)-$(MinVerPreRelease)</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="AutoConstructor" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(MajorRevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(MajorRevitVersion).*" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Models\" />
	</ItemGroup>

</Project>
